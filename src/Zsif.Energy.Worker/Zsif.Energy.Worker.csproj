<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Zsif.Energy.Worker-709245b7-a0b9-4d33-95b5-287b0541a230</UserSecretsId>
  </PropertyGroup>

  <!--Local Windows runs go through dotnet.exe, the generated exe is blocked by policy; Linux publish keeps its apphost-->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' And '$(RuntimeIdentifier)' == ''">
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.14" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>
</Project>
